                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "simulation"
                ],
                "summary": "Iniciar simulação de carga",
                "parameters": [
                    {
                        "description": "configuração da execução",
                        "name": "body",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/internal_simulation.startRequest"
