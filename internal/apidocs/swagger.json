                            "additionalProperties": true
                        }
                    },
                    "409": {
                        "description": "error.code=SETTLE_ON_FAILED ou TRANSFER_NOT_BOOKED",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
